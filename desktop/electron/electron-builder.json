{
  "appId": "com.vibelution.desktop",
  "productName": "Vibelution",
  "directories": {
    "output": "../../dist/desktop"
  },
  "files": [
    "dist/**/*",
    "desktop-entry-catalog.json",
    "package-provenance.json",
    "package.json"
  ],
  "asarUnpack": [
    "package-provenance.json"
  ],
  "extraResources": [
    {
      "from": "../../web/dist",
      "to": "web-dist"
    }
  ],
  "win": {
    "icon": "../../assets/icons/vibelution.ico",
    "target": [
      "dir"
    ],
    "artifactName": "Vibelution-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      "dir"
    ],
    "artifactName": "Vibelution-${version}-${arch}.${ext}"
  }
}
