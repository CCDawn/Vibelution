{
  "name": "vibelution-desktop",
  "private": true,
  "version": "1.0.16",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/runDesktopPackage.js --mode unpackaged",
    "build:job": "node scripts/runDesktopPackage.js --mode unpackaged",
    "build:preload": "node scripts/runDesktopPackage.js --mode unpackaged",
    "package:dir": "node scripts/runDesktopPackage.js --mode dir",
    "package:staging": "node scripts/runDesktopPackage.js --mode staging",
    "package:linux-arm64:dir": "node scripts/runDesktopPackage.js --mode linux-arm64",
    "test": "vitest run tests",
    "dev": "npm run build && electron dist/main.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "42.5.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
