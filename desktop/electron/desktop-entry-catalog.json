      "reason": "Operator and development adapter; not a packaged product shortcut."
    },
    {
      "id": "python-launcher-adapter",
      "path": "scripts/vibelution_launcher.py",
      "publicProductEntry": false,
      "reason": "Operator and development adapter; not a packaged product shortcut."
    }
  ],
  "fallbackProviders": [
    {
      "id": "legacy-edge-app-window-provider",
      "provider": "edge_app",
      "publicProductEntry": false,
      "reason": "Compatibility fallback while Electron becomes the default product shell."
    }
  ],
  "forbiddenProductEntries": [
    {
      "id": "direct-workbench-shortcut",
      "target": "workbench",
      "reason": "Workbench opens through Launcher/Supervisor so lifecycle and active-work guards remain authoritative."
    }
  ],
  "deepLinks": [
