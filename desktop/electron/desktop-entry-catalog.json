{
  "schemaVersion": 1,
  "publicProductEntries": [
    {
      "id": "vibelution-desktop-package",
      "label": "Vibelution",
      "path": "dist/desktop/win-unpacked/Vibelution.exe",
      "target": "launcher",
      "windowProvider": "electron",
      "shortcutAllowed": true,
      "publicProductEntry": true
    }
  ],
  "operatorEntries": [
    {
      "id": "powershell-launcher-adapter",
      "path": "scripts/vibelution_launcher.ps1",
