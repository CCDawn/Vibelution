#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
current_branch=$(git branch --show-current 2>/dev/null || true)
if [ "$current_branch" = "main" ]; then
  echo "[pre-commit] direct commits on main are blocked; use a codex/<task-slug> worktree and merge with git merge --ff-only" >&2
  exit 1
fi

dependency_root=$repo_root
if [ ! -x "$dependency_root/.venv/Scripts/python.exe" ] && [ ! -x "$dependency_root/.venv/bin/python" ]; then
  git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  case "$git_common_dir" in
    */.git) dependency_root=${git_common_dir%/.git} ;;
  esac
fi

if [ -x "$dependency_root/.venv/Scripts/python.exe" ]; then
  project_python="$dependency_root/.venv/Scripts/python.exe"
elif [ -x "$dependency_root/.venv/bin/python" ]; then
  project_python="$dependency_root/.venv/bin/python"
else
  project_python=""
fi

if [ -z "$project_python" ]; then
  echo "[pre-commit] missing project Python under .venv/Scripts or .venv/bin" >&2
  echo "[pre-commit] repair: powershell -ExecutionPolicy Bypass -File scripts/vibelution_launcher.ps1 -Action repair-deps" >&2
  exit 1
fi

"$project_python" "$repo_root/scripts/git_claim_guard.py" ensure-claim --repo "$repo_root"

if ! git diff --cached --quiet -- web/package.json web/package-lock.json; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "[pre-commit] missing npm; cannot verify staged web dependency metadata" >&2
    exit 1
  fi

  # When dependency metadata is staged, validate the current worktree package
  # manifest/lock pair without changing either file. Unrelated commits do not
  # pay this dependency-resolution cost.
  npm --silent --prefix "$repo_root/web" ci --ignore-scripts --dry-run --no-audit --no-fund
fi

exec "$project_python" "$repo_root/scripts/local_quality_gate.py" commit
